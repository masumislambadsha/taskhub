# Production runtime settings for the realtime Socket.io server.
# Copy to deploy/env/realtime.env on the VPS and fill it in:
#
#   cp deploy/env/realtime.env.example deploy/env/realtime.env
#   chmod 600 deploy/env/realtime.env
#
# Never commit realtime.env (it is in .gitignore). With CI/CD on, the same content
# is stored in the GitHub secret REALTIME_ENV_PRODUCTION.
#
# The realtime image has no build-time settings: everything it needs is here.

PORT=3001
# Same Atlas database as the web app.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/taskhub?retryWrites=true&w=majority
# Public URL of the web app. The server adds it to its CORS allow-list.
# It must match the URL users open in the browser, with https:// and no trailing slash.
NEXT_PUBLIC_APP_URL=https://taskhub.example.com
# Verifies the chat token signed by the web app. MUST be identical to SOCKET_JWT_SECRET in web.env.
# Generate with: openssl rand -base64 48
SOCKET_JWT_SECRET=
LOG_LEVEL=info

# --- Error monitoring (Sentry) ----------------------------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=production-vps
SENTRY_TRACES_SAMPLE_RATE=0.1
