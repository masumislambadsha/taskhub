# Production runtime settings for the web app AND the worker (compose.prod.yml
# loads this file into both). Copy to deploy/env/web.env on the VPS and fill it in:
#
#   cp deploy/env/web.env.example deploy/env/web.env
#   chmod 600 deploy/env/web.env
#
# Never commit web.env (it is in .gitignore). With CI/CD on, the same content is
# stored in the GitHub secret WEB_ENV_PRODUCTION and written to the VPS on each deploy.
#
# NEXT_PUBLIC_* values are NOT set here. Next.js bakes them into the browser
# bundle when the web image is built, so they come from GitHub repository
# variables (NEXT_PUBLIC_SOCKET_URL, NEXT_PUBLIC_APP_URL, NEXT_PUBLIC_SENTRY_DSN,
# NEXT_PUBLIC_IMGBB_API_KEY, SENTRY_ENVIRONMENT) and not from this file.
# Changing them means building a new image, not editing this file.
#
# REDIS_URL is set by compose.prod.yml (redis://redis:6379). Do not set it here.

# --- Database ---------------------------------------------------------------
# MongoDB Atlas connection string. In Atlas, add the VPS IP under Network Access.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/taskhub?retryWrites=true&w=majority

# --- Auth.js (next-auth v5) -------------------------------------------------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=change-me-to-a-long-random-string
# Public HTTPS URL of this deployment. Also used for payment callbacks and reset links.
NEXTAUTH_URL=https://taskhub.example.com
# Required behind Nginx: trust the X-Forwarded-* headers.
AUTH_TRUST_HOST=true
# Google OAuth client. Add https://taskhub.example.com/api/auth/callback/google
# to the authorised redirect URIs in the Google Cloud console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Realtime chat -----------------------------------------------------------
# Signs the short-lived chat token. MUST be identical in realtime.env.
# Generate with: openssl rand -base64 48
SOCKET_JWT_SECRET=

# --- Stripe -----------------------------------------------------------------
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint https://taskhub.example.com/api/v1/payments/stripe/webhook
# (a new endpoint in the Stripe dashboard has its own secret).
STRIPE_WEBHOOK_SECRET=

# --- bKash ------------------------------------------------------------------
BKASH_BASE_URL=
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=

# --- SSLCommerz -------------------------------------------------------------
SSLCOMMERZ_BASE_URL=
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=

# --- Email (Resend) ---------------------------------------------------------
RESEND_API_KEY=

# --- Image uploads (imgbb) --------------------------------------------------
# Server-side key. The browser-side key is the build variable NEXT_PUBLIC_IMGBB_API_KEY.
IMGBB_API_KEY=

# --- Operations -------------------------------------------------------------
LOG_LEVEL=info
# Port of the worker's internal /health endpoint (inside its container).
WORKER_HEALTH_PORT=4100

# --- Error monitoring (Sentry) ----------------------------------------------
# Empty DSN turns Sentry off.
SENTRY_DSN=
# Different from the Vercel deployment's "production", so VPS errors can be told apart.
SENTRY_ENVIRONMENT=production-vps
SENTRY_TRACES_SAMPLE_RATE=0.1
