# Input for scripts/set-github-secrets.sh (or .ps1).
# Copy to deploy/github-secrets.input.env (gitignored) and fill it in.
# Lines starting with # and empty lines are ignored. No quotes needed.
# The script never prints these values.

# --- Docker Hub ---------------------------------------------------------------
# Your Docker Hub user name (becomes the GitHub variable DOCKERHUB_USERNAME).
DOCKERHUB_USERNAME=your-dockerhub-user
# A Docker Hub access token with Read & Write access (becomes the secret DOCKERHUB_TOKEN).
DOCKERHUB_TOKEN=

# --- VPS ----------------------------------------------------------------------
# Server IP or host name (secret VPS_HOST).
VPS_HOST=203.0.113.10
# Login user created by vps-setup.sh (secret VPS_USER).
VPS_USER=deploy
# Optional SSH port (secret VPS_PORT). Leave empty for 22.
VPS_PORT=
# Path to the PRIVATE key file that CI uses to log in (secret VPS_SSH_KEY).
# Use a key made only for CI: ssh-keygen -t ed25519 -f ~/.ssh/taskhub_ci -C taskhub-ci
VPS_SSH_KEY_FILE=~/.ssh/taskhub_ci
# Folder of the repo on the VPS (variable VPS_APP_DIR).
VPS_APP_DIR=/opt/apps/taskhub

# --- Build variables (baked into the web image) -------------------------------
NEXT_PUBLIC_SOCKET_URL=https://taskhub.example.com
NEXT_PUBLIC_APP_URL=https://taskhub.example.com
# Optional. Empty means "not set".
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_IMGBB_API_KEY=
SENTRY_ENVIRONMENT=production-vps

# --- Optional -----------------------------------------------------------------
# owner/repo to set the values on. Empty means the repo of the current git folder.
GITHUB_REPO=masumislambadsha/taskhub
