# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/dist/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
requirements
.npmrc
mobile

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.getaibd/

# project requirements doc — never commit
/Squid Game-7 Project 1 Upgrade Session.txt

# manual-testing leftovers
*cookies*.txt
resp.json

# deployment: real runtime env files and the secrets-upload input (the .example files stay tracked)
deploy/env/*.env
deploy/github-secrets.input.env
deploy/*.pem
deploy/id_*

# deploy.sh state (current and previous image tag on the VPS)
/.deploy/
