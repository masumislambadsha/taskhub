# TaskHub realtime server (Express + Socket.io). Copy to server/.env.
# Values below are empty or obviously fake placeholders.

# Port to listen on. Defaults to 3001 (Render sets PORT itself).
PORT=3001
# Same MongoDB database as the web app (the server reads and writes messages).
MONGODB_URI=mongodb://localhost:27017/taskhub?directConnection=true
# Public URL of the web app, added to the CORS allow-list.
# http://localhost:3000 and https://task-hub-io.vercel.app are always allowed.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Alternative to PORT, used only when PORT is not set.
SOCKET_PORT=
