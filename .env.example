# TaskHub environment variables (web app, worker, Docker Compose).
# Copy to .env and fill in real values. Never commit .env.
# Values below are empty or obviously fake placeholders.

# --- Database ---------------------------------------------------------------
# MongoDB connection string. Docker Compose overrides this for its own mongo service.
MONGODB_URI=mongodb://localhost:27017/taskhub?directConnection=true

# --- Redis (worker, readiness check, later queues) ---------------------------
# Optional on Vercel: when empty, /api/health/ready skips the Redis check.
# Docker Compose overrides this to redis://redis:6379.
REDIS_URL=

# How long a buyer has to review a submission before the worker process approves
# it automatically, in milliseconds. Default 259200000 (72 hours). Use a few
# thousand to try it out. Needs the worker running with REDIS_URL set.
AUTO_APPROVE_AFTER_MS=

# --- Auth.js (next-auth v5) -------------------------------------------------
# Random secret for signing session tokens. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=change-me-to-a-long-random-string
# Public base URL of the web app (also used to build payment callback and reset-password links).
NEXTAUTH_URL=http://localhost:3000
# Set to true when running behind a reverse proxy such as Nginx (not needed on Vercel).
AUTH_TRUST_HOST=
# Google OAuth client from the Google Cloud console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Stripe -----------------------------------------------------------------
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint /api/v1/payments/stripe/webhook.
STRIPE_WEBHOOK_SECRET=

# --- bKash ------------------------------------------------------------------
# Sandbox: https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_BASE_URL=
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=

# --- SSLCommerz -------------------------------------------------------------
# Sandbox: https://sandbox.sslcommerz.com
SSLCOMMERZ_BASE_URL=
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=

# --- Email (Resend) ---------------------------------------------------------
RESEND_API_KEY=

# --- Image uploads (imgbb) --------------------------------------------------
# Server-side key used by /api/v1/uploads/imgbb.
IMGBB_API_KEY=
# Browser-side key used by the task and submission forms. It is public by design.
NEXT_PUBLIC_IMGBB_API_KEY=

# --- Realtime server --------------------------------------------------------
# URL the browser uses to reach the Socket.io server. Baked in at build time.
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001
# Public URL of the web app. The realtime server adds it to its CORS allow-list.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Operations -------------------------------------------------------------
# Log verbosity for the web app and worker (debug, info, warn, error). Defaults to info.
LOG_LEVEL=info
# Port for the worker's internal GET /health endpoint. Defaults to 4100.
WORKER_HEALTH_PORT=4100
# Optional git commit SHA, reported as "version" by the health endpoints.
# GIT_SHA=
# Set to 1 only for Docker builds. Makes Next.js emit a standalone server.
# Leave unset on Vercel.
BUILD_STANDALONE=

# --- Error monitoring (Sentry) ----------------------------------------------
# Everything here is optional. With no DSN, Sentry is completely disabled.
# DSN for the server and edge runtimes and the worker.
SENTRY_DSN=
# DSN for the browser. Baked in at build time, so set it before `npm run build`.
# Usually the same value as SENTRY_DSN (a DSN is not secret).
NEXT_PUBLIC_SENTRY_DSN=
# Environment name shown in Sentry, e.g. production or staging.
SENTRY_ENVIRONMENT=
# Share of requests to trace, from 0 to 1. Defaults to 0.1.
SENTRY_TRACES_SAMPLE_RATE=0.1
# Source-map upload at build time. Leave all three unset to skip the upload;
# the build never needs network access to Sentry. Release name comes from GIT_SHA.
# SENTRY_AUTH_TOKEN is a secret: set it in the build environment only.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# --- Development seed script (npm run seed) ---------------------------------
# The seed script refuses to run against a non-local database unless this is 1.
SEED_ALLOW_REMOTE=
# Shared password for all seeded accounts. Defaults to a documented dev password.
SEED_PASSWORD=
# Password for the seeded admin owner@taskhub.com. If empty, a random one is
# printed once when the account is created. (admin@taskhub.com is the read-only
# demo admin; its password, 121212, is public on the login page.)
SEED_ADMIN_PASSWORD=

# --- Realtime chat -----------------------------------------------------------
# Secret that signs the short-lived chat token from /api/v1/socket-token.
# Must be the same value on the web app and the realtime server (server/.env).
# Generate with: openssl rand -base64 48   (at least 32 characters; with no
# valid value the token endpoint returns 500 and the realtime server rejects every connection)
SOCKET_JWT_SECRET=

# --- Admin two-factor ---------------------------------------------------------
# Key that encrypts admins' authenticator secrets (AES-256-GCM). 32 bytes as
# base64 or 64 hex characters. Generate with: openssl rand -base64 32
# Losing or changing it makes every admin enroll again. Never commit a real one.
MFA_ENCRYPTION_KEY=
# Admins must use two-factor unless this is exactly "false" (local development only).
MFA_ENFORCED=
